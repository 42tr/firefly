# =============================================================================
# 数据库
# =============================================================================
# 可选，默认使用进程工作目录下的 firefly.sqlite3
# DATABASE_URL=sqlite:///absolute/path/to/firefly.sqlite3

# 连接池配置（可选）
DB_MAX_CONNECTIONS=4
DB_ACQUIRE_TIMEOUT_SECS=10
DB_IDLE_TIMEOUT_SECS=600

# =============================================================================
# 服务绑定
# =============================================================================
BIND_ADDRESS=0.0.0.0:3003

# 核心调度、周统计和日志使用的 IANA 时区；修改后重启。
# 例如 UTC、Asia/Shanghai、America/New_York。
APP_TIMEZONE=Asia/Shanghai

# 对话未更新保留天数；0 关闭自动清理。归档和置顶同样遵循此期限。
CONVERSATION_RETENTION_DAYS=30

# 浏览器标签页标题（可选，未设置或留空时使用「流萤」）；修改后重启服务生效。
SITE_TITLE=流萤

# =============================================================================
# 认证
# =============================================================================
# Firefly 本地会话 JWT 签名密钥：至少 32 字节，必须替换为强随机字符串
JWT_SECRET=change-me-to-a-long-random-secret

# 本站访问密码：至少 9 个字符；没有用户名、注册或外部认证服务。
# 必须替换示例值，修改后重启服务，旧登录会话自动失效。
AUTH_PASSWORD=change-me-to-a-private-password

# Cookie secure 标志：true=只在 HTTPS 传输；false=允许 HTTP
# 不设置时，release 模式默认为 true，debug 模式默认为 false
COOKIE_SECURE=false

# =============================================================================
# CORS 跨域
# =============================================================================
# 仅控制浏览器直接跨域的 HTTP 请求；同源开发代理和 WebSocket 不使用此白名单。
# 多个来源用英文逗号分隔
CORS_ALLOWED_ORIGINS=http://localhost:5173

# =============================================================================
# Firefly 初始模型与运行配置
# =============================================================================
# 首次初始化 Firefly 模型时使用（BASE_URL 必须支持 /responses）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Firefly 初始系统提示、模型输入预算与执行期限（可选）
# ASSISTANT_SYSTEM_PROMPT=...
# Responses 请求不设置输出上限，使用模型服务自身的输出限制
# 默认查询模型上下文窗口，预留模型最大输出空间及 5% 安全余量；成功缓存 1 小时
# 可选输入预算上限；查询失败时仅使用这个显式配置兜底，无隐含 32768 默认值
# 占用量仍保守估算：文本按 UTF-8 字节计，每图预留 4096；非计费 token 数
# ASSISTANT_CONTEXT_TOKENS=32768
# ASSISTANT_RUN_TIMEOUT_SECS=86400
# OPENAI_*、ASSISTANT_SYSTEM_PROMPT、ASSISTANT_CONTEXT_TOKENS 和 ASSISTANT_RUN_TIMEOUT_SECS
# 用于首次初始化 Firefly Agent 配置。此后通过“左下角设置 → Agent 配置”修改并即时保存。
# 不内置子 agent；在配置页面创建、分配工具并启用，也可导入配置文件。
# 主助手及动态子 agent 均不设工具调用次数上限。
# 所有 Agent 共用的并发额度与等待队列上限
# ASSISTANT_MAX_CONCURRENT_JOBS=4
# ASSISTANT_MAX_QUEUED_JOBS=32
# Firefly 工具的全局开关；具体工具权限在 Agent 配置中分配
# ASSISTANT_ENABLE_TOOLS=true

# 可开启通用 http_request 工具，并在 Agent 配置中分配权限
# ASSISTANT_HTTP_TOOL_ENABLED=false
# 允许访问的域名白名单，英文逗号分隔；留空时仅允许公网地址
# ASSISTANT_HTTP_TOOL_ALLOWED_HOSTS=deploy.internal,example.com

# 独立业务模块由部署者单独安装和维护。
# 凭据和业务配置在各模块设置中填写，见 docs/modules.md。

# Codex / Claude Code Agent（使用前需在服务运行账户下完成对应 CLI 登录）
# CODEX_MODEL=
# 各 API 平台（~/.codex/config.toml 的 model_providers）的可选模型覆盖，
# 格式 provider=m1,m2;provider2=m3；默认自动请求各平台的 /models 接口获取，一般无需配置
# CODEX_PROVIDER_MODELS=
# CLAUDE_MODEL=
# Claude 模型下拉选项，逗号分隔；留空提供 sonnet、opus、haiku，也支持前端输入自定义名称。
# CLAUDE_MODELS=
# CLAUDE_PERMISSION_MODE=dontAsk
# CLAUDE_ALLOWED_TOOLS=Bash,Edit,Write,Read,Glob,Grep,WebFetch,WebSearch,NotebookEdit

# 附件上传目录（可选，默认 storage/assistant_uploads）
ASSISTANT_UPLOAD_DIR=storage/assistant_uploads

# 单个上传附件上限，单位 MB（1 MB = 1024 × 1024 字节），普通文件和视频统一限制。
# 必须为正整数，默认 100；修改后重启服务生效，前端不限制文件大小。
# 整次请求默认上限 256MB；配置更大时自动提升至单附件上限 + 1MB，预留表单开销。
ASSISTANT_MAX_ATTACHMENT_MB=100

# Agent 工作区根目录
WORKSPACE_ROOT=workspace

# Firefly agent 的后台工具任务（不改变 Codex / Claude 独立会话模式）
# 不设执行名额上限，保留显式资源互斥与工具串行规则；排队不设超时，执行期限从真正启动时开始。
# ASSISTANT_TASK_QUEUE_LIMIT=256
# ASSISTANT_COMMAND_TIMEOUT_SECS=7200
# ASSISTANT_TOOL_TIMEOUT_SECS=300
# ASSISTANT_TASK_MAX_TIMEOUT_SECS=604800
# ASSISTANT_COMMAND_CANCEL_GRACE_SECS=3
# ASSISTANT_TASK_OUTPUT_BYTES=16777216

# 外部模块：目录内可放模块包（包含 module.toml）或单个 MCP .toml 文件。
# 新模块默认停用，在“左下角设置 → 扩展模块”中配置并启用。
MODULES_DIR=modules
MODULE_DATA_DIR=storage/modules
